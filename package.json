{
  "name": "react-native-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "expo:ios": "expo run:ios",
    "ios": "npx expo run:ios",
    "ios:alternate-port": "RCT_METRO_PORT=8083 pnpm exec expo run:ios --port 8083",
    "web": "expo start --web",
    "lint": "biome check .",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc",
    "clean": "npx react-native clean",
    "pods:install": "cd ios && pod install && cd ..",
    "test": "jest --watch",
    "test:run": "jest --watchAll=false",
    "test:coverage": "jest --coverage --watchAll=false",
    "e2e": "maestro test e2e/",
    "e2e:flow": "maestro test",
    "clean-project": "npx react-native-clean-project",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start"
  },
  "dependencies": {
    "@babel/preset-react": "7.29.7",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@expo-google-fonts/source-sans-3": "0.4.1",
    "@expo/metro-runtime": "56.0.13",
    "@expo/vector-icons": "15.1.1",
    "@shopify/react-native-skia": "2.6.4",
    "@types/lodash": "4.17.24",
    "deepmerge-ts": "7.1.5",
    "expo": "56.0.8",
    "expo-blur": "56.0.3",
    "expo-constants": "56.0.16",
    "expo-font": "56.0.5",
    "expo-haptics": "56.0.3",
    "expo-image": "56.0.9",
    "expo-linking": "56.0.13",
    "expo-localization": "56.0.6",
    "expo-router": "56.2.8",
    "expo-splash-screen": "56.0.10",
    "expo-sqlite": "56.0.4",
    "expo-status-bar": "56.0.4",
    "expo-symbols": "56.0.5",
    "expo-system-ui": "56.0.5",
    "expo-web-browser": "56.0.5",
    "i18next": "26.3.0",
    "lodash": "4.18.1",
    "lottie-react-native": "7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "3.0.0",
    "react-native-mmkv": "4.3.1",
    "react-native-reanimated": "4.4.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.25.2",
    "react-native-unistyles": "3.2.5",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.9.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@react-native-community/cli": "20.1.3",
    "@storybook/addon-ondevice-actions": "10.4.4",
    "@storybook/addon-ondevice-backgrounds": "10.4.4",
    "@storybook/addon-ondevice-controls": "10.4.4",
    "@storybook/react-native": "10.4.4",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.15",
    "@types/react-test-renderer": "19.1.0",
    "jest-expo": "56.0.4",
